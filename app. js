document.addEventListener('DOMContentLoaded', function() {
    var btn = document.getElementById('analyze-btn');
    var input = document.getElementById('dialog-input');

    if (!btn || !input) {
        alert('Ошибка: не найдены элементы на странице.');
        return;
    }

    btn.addEventListener('click', function() {
        var text = input.value.trim();
        if (!text) {
            alert('Вставьте текст переписки.');
            return;
        }

        // Простой анализ (без сложных парсеров)
        var lines = text.split('\n').filter(function(line) { return line.trim() !== ''; });
        var messages = [];
        var currentSender = null;
        var currentText = '';

        for (var i = 0; i < lines.length; i++) {
            var line = lines[i];
            var match = line.match(/^(.+?):\s*(.*)/);
            if (match) {
                if (currentSender && currentText) {
                    messages.push({ sender: currentSender, text: currentText.trim() });
                }
                currentSender = match[1].trim();
                currentText = match[2].trim();
            } else {
                currentText += ' ' + line.trim();
            }
        }
        if (currentSender && currentText) {
            messages.push({ sender: currentSender, text: currentText.trim() });
        }

        if (messages.length < 2) {
            alert('Не удалось распознать диалог. Убедитесь, что реплики начинаются с "Имя: текст".');
            return;
        }

        // ----- Анализ по 5 простым правилам -----
        var fullText = messages.map(function(m) { return m.text; }).join(' ').toLowerCase();
        var hasGreeting = /здравствуй|добрый день|привет|доброе утро/.test(fullText);
        var hasEmpathy = /понимаю|извините|спасибо|благодарю/.test(fullText);
        var hasQuestion = /\?/.test(fullText);
        var hasPrice = /цена|стоимость|руб/.test(fullText);
        var hasFacts = /\d{2,}|%/.test(fullText);

        var score = 50;
        if (hasGreeting) score += 10;
        if (hasEmpathy) score += 15;
        if (hasQuestion) score += 10;
        if (hasPrice) score += 5;
        if (hasFacts) score += 10;
        if (messages.length > 4) score += 5; // бонус за активный диалог

        score = Math.min(100, Math.max(0, score));

        // Главная ошибка (простая логика)
        var error = 'Ошибок не найдено.';
        var suggestion = 'Продолжайте в том же духе.';
        if (!hasGreeting) {
            error = 'Вы не поздоровались с клиентом.';
            suggestion = 'Начинайте диалог с приветствия: "Здравствуйте!" или "Добрый день!".';
        } else if (!hasEmpathy) {
            error = 'Вы не проявили эмпатию.';
            suggestion = 'Используйте слова: "понимаю", "спасибо", "благодарю" — это создаёт доверие.';
        } else if (!hasQuestion) {
            error = 'В диалоге нет вопросов.';
            suggestion = 'Задавайте уточняющие вопросы, чтобы лучше понять потребности клиента.';
        } else if (!hasPrice && hasGreeting && hasEmpathy) {
            error = 'Вы не обсудили стоимость.';
            suggestion = 'Уточните бюджет или цену, чтобы двигаться к сделке.';
        }

        // Генерация черновиков
        var lastClientMsg = messages.filter(function(m, idx) { return idx % 2 === 0; }).pop();
        var clientText = lastClientMsg ? lastClientMsg.text : '';

        var drafts = {
            soft: 'Понимаю ваше беспокойство. Давайте вместе разберёмся в этом вопросе.\n\nЕсли готовы продолжить, давайте обсудим детали.',
            business: 'Благодарю за обращение. Предлагаю перейти к следующему шагу. Какие вопросы у вас остались?',
            expert: 'Отличный вопрос. На основе моего опыта, рекомендую начать с анализа. Когда вам удобно созвониться?'
        };

        // Отображение результата
        document.getElementById('step-upload').style.display = 'none';
        var container = document.getElementById('step-result');
        container.style.display = 'block';

        var scoreColor = score >= 70 ? 'score-good' : (score >= 40 ? 'score-medium' : 'score-bad');

        container.innerHTML = `
            <div class="result-card">
                <div class="big-score ${scoreColor}">${score}/100</div>
                <div class="score-label">Индекс качества диалога</div>

                <div class="error-box">
                    <strong>🔥 Главная ошибка</strong>
                    <p>${error}</p>
                </div>

                <div class="suggestion-box">
                    <strong>💡 Как исправить</strong>
                    <p>${suggestion}</p>
                </div>

                <div style="margin-top:16px;">
                    <div><strong>✅ Что получилось хорошо</strong></div>
                    <div class="feedback-list">
                        ${hasGreeting ? '<div class="feedback-item positive">✔ Вы поприветствовали клиента</div>' : ''}
                        ${hasEmpathy ? '<div class="feedback-item positive">✔ Проявили эмпатию</div>' : ''}
                        ${hasQuestion ? '<div class="feedback-item positive">✔ Задали вопросы</div>' : ''}
                        ${hasPrice ? '<div class="feedback-item positive">✔ Обсудили стоимость</div>' : ''}
                        ${hasFacts ? '<div class="feedback-item positive">✔ Использовали факты или цифры</div>' : ''}
                        ${!hasGreeting && !hasEmpathy && !hasQuestion ? '<p style="color:#94a3b8;">Пока нет положительных моментов</p>' : ''}
                    </div>
                </div>

                <div style="margin-top:16px;">
                    <strong>💬 Лучший ответ</strong>
                    <div class="draft-buttons">
                        <button onclick="copyText('${drafts.soft.replace(/'/g, "\\'")}')">Мягкий</button>
                        <button onclick="copyText('${drafts.business.replace(/'/g, "\\'")}')">Деловой</button>
                        <button onclick="copyText('${drafts.expert.replace(/'/g, "\\'")}')">Экспертный</button>
                    </div>
                </div>

                <button class="btn-reset" onclick="location.reload()">🔄 Новый анализ</button>
            </div>
        `;
    });
});

function copyText(text) {
    if (navigator.clipboard) {
        navigator.clipboard.writeText(text).then(function() {
            alert('✅ Скопировано! Отправьте клиенту.');
        }).catch(function() {
            alert(text);
        });
    } else {
        alert(text);
    }
}

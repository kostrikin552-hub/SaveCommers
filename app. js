document.addEventListener('DOMContentLoaded', function() {
    const btn = document.getElementById('analyze-btn');
    const input = document.getElementById('dialog-input');

    if (!btn || !input) {
        alert('Ошибка загрузки интерфейса. Проверьте HTML.');
        return;
    }

    btn.addEventListener('click', function() {
        const text = input.value.trim();
        if (!text) {
            alert('Пожалуйста, вставьте текст переписки.');
            return;
        }

        const lines = text.split('\n').filter(line => line.trim() !== '');
        const messages = [];
        let currentSender = null;
        let currentText = '';

        for (const line of lines) {
            const match = line.match(/^(.+?):\s*(.*)/);
            if (match) {
                if (currentSender && currentText) {
                    messages.push({ sender: currentSender, text: currentText.trim() });
                }
                currentSender = match[1].trim();
                currentText = match[2].trim();
            } else {
                currentText += ' ' + line.trim();
            }
        }
        if (currentSender && currentText) {
            messages.push({ sender: currentSender, text: currentText.trim() });
        }

        if (messages.length < 2) {
            alert('Не удалось распознать диалог. Убедитесь, что каждая реплика начинается с "Имя: текст".');
            return;
        }

        const result = analyzeDialogFull(messages);
        showResultFull(result);
    });
});

